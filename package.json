    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.108.2",
    "@vercel/analytics": "^2.0.1",
    "headroom-ai": "^0.44.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-toastify": "^11.2.0",
    "tailwind-merge": "^3.7.1",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.108.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
